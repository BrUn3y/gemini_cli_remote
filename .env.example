# Option 1: API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=auto

# Option 2: Vertex AI on Google Cloud (ADC / VM service account).
# Leave GEMINI_API_KEY empty; enable Vertex AI and grant Vertex AI User to the SA.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_API_KEY=                        # alternative: Vertex express-mode key

# Option 3: native only, run `gemini` as the service user and sign in once.
# The launcher recognizes ~/.gemini/oauth_creds.json. Never commit that file.

# Native default: 127.0.0.1:8081. Container: same host port, internal port 8080.
HARNESS_PORT=8081
# HARNESS_HOST=127.0.0.1                 # native only
# GEMINI_WORKDIR=/absolute/path/to/workspace  # native only
# GEMINI_BIN=gemini
# GEMINI_MAX_JOBS=100

# Optional Slack integration. Leave BOTH blank for API only.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_CHANNELS=
SLACK_DEFAULT_CHANNEL=
# GEMINI_REMOTE_URL=http://127.0.0.1:8081  # separate bot pointing to an existing API
# SLACK_WORKDIR=/workspace              # path as seen by the API
# GEMINI_INVOKE_TIMEOUT=600
# SLACK_MAX_CONCURRENT=2
# SLACK_EVENT_TTL_SECONDS=3600
# SLACK_MAX_FILE_BYTES=26214400
# SLACK_UPLOAD_TTL_SECONDS=604800
# SLACK_UPLOAD_MAX_BYTES=536870912
# SLACK_UPLOAD_CLEANUP_SECONDS=3600
# SLACK_THINKING_INTERVAL=5
# GEMINI_SCHEDULES_FILE=/workspace/schedules.json
# GEMINI_CRON_LOG=/workspace/cron.log
